{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Float",
  "version": "0.1.0",
  "identifier": "com.float.app.windows",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8443",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Float",
        "label": "main",
        "width": 560,
        "height": 400,
        "minWidth": 560,
        "minHeight": 400,
        "x": 0,
        "y": 0,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "fullscreen": false,
        "center": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ws:;"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
